{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PaneKeeper",
  "version": "0.2.0",
  "identifier": "com.szymonjankiewicz.panekeeper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1431",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "PaneKeeper",
      "width": 960,
      "height": 640,
      "minWidth": 420,
      "minHeight": 480,
      "decorations": true,
      "transparent": true,
      "windowEffects": { "effects": ["mica"] }
    }],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../THIRD_PARTY.md": "THIRD_PARTY.md",
      "../LICENSE": "LICENSE.txt",
      "../THIRD_PARTY_LICENSES.txt": "THIRD_PARTY_LICENSES.txt"
    },
    "windows": { "nsis": { "installMode": "currentUser", "installerHooks": "windows/hooks.nsh" } }
  }
}
