{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WindowsKeeper",
  "version": "0.1.0",
  "identifier": "com.szymonjankiewicz.windowskeeper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1431",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "WindowsKeeper",
      "width": 960,
      "height": 680,
      "minWidth": 400,
      "minHeight": 520
    }],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../THIRD_PARTY.md": "THIRD_PARTY.md",
      "../LICENSE": "LICENSE.txt"
    },
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
